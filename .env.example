# Copy to .env and fill in the values shown by `exasol info`.
EXASOL_HOST=127.0.0.1
EXASOL_PORT=8563
EXASOL_USER=sys
EXASOL_PASSWORD=
# Exasol Personal uses a self-signed TLS certificate by default.
EXASOL_ENCRYPTION=true
EXASOL_VERIFY_CERT=false

# Optional: Gemini API key for plain-English incident reports (free tier works).
# Without it, TrustLayer writes a template report instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
